<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="KEYCODE.Site" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KEYCODE</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="<%= ResolveUrl("~/Asm_StyleSheet/WebPageStyle.css?v=" + DateTime.Now.Ticks) %>" rel="stylesheet" />
    <link href="<%= ResolveUrl("~/Asm_StyleSheet/MasterStyle.css?v=" + DateTime.Now.Ticks) %>" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>

<body>
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" />

        <!-- Topbar: logo only -->
        <header class="topbar">
            <div class="topbar__left">
                <a class="brand" href="<%= ResolveUrl("~/Asm_WebPage/HomePage.aspx") %>">
                    <img src="<%= ResolveUrl("~/logo.png") %>" alt="KEYCODE Logo" class="brand__logo" />
                </a>
            </div>
        </header>

        <!-- ===== Global left sidebar (full-height rail, on every page) ===== -->
        <aside class="dash-sidebar" id="dashSidebar">
            <button type="button" class="side-toggle" onclick="toggleSidebar()" title="Collapse menu">
                <span class="icon-menu">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                </span>
                <span class="icon-chevron">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </span>
            </button>

            <nav class="side-nav-list">

                <a class='side-nav-item <%= Request.Url.AbsolutePath.ToLower().Contains("dashboard") ? "active" : "" %>'
                href='<%= GetDashboardUrl() %>'>

                    <span class="side-nav-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>
                    </span>
                    <span class="side-nav-label">Dashboard</span>
                </a>

                <a class='side-nav-item <%= Request.Url.AbsolutePath.ToLower().Contains("battlegame.aspx") ? "active" : "" %>'
                   href="<%= ResolveUrl("~/Asm_WebPage/BattleGame.aspx") %>">
                    <span class="side-nav-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="12" x2="10" y2="12"></line><line x1="8" y1="10" x2="8" y2="14"></line><circle cx="15" cy="13" r="1"></circle><circle cx="18" cy="11" r="1"></circle><path d="M17.32 5H6.68a4 4 0 0 0-3.978 3.59c-.006.052-.01.101-.017.152C2.604 9.416 2 14.456 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.414-1.414A2 2 0 0 1 9.828 16h4.344a2 2 0 0 1 1.414.586L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.544-.604-6.584-.685-7.258-.007-.05-.011-.1-.017-.152A4 4 0 0 0 17.32 5z"></path></svg>
                    </span>
                    <span class="side-nav-label">Mini Game</span>
                </a>

                <asp:Panel ID="pnlForumIcon" runat="server" Visible="true">
                    <a class='side-nav-item <%= Request.Url.AbsolutePath.ToLower().Contains("forum.aspx") ? "active" : "" %>'
                       href="<%= ResolveUrl("~/Asm_WebPage/Forum.aspx") %>">
                        <span class="side-nav-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                        </span>
                        <span class="side-nav-label">Forum</span>
                    </a>
                </asp:Panel>


<% if (IsAdminNavigation) { %>
<a class='side-nav-item <%= AdminNavClass("UserManagement.aspx") %>' href='<%= ResolveUrl("~/Asm_WebPage/UserManagement.aspx") %>' title="User Management" aria-current='<%= AdminNavClass("UserManagement.aspx") == "active" ? "page" : "false" %>'>
<span class="side-nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3M16 5a3 3 0 0 1 0 6M21 21v-3a6 6 0 0 0-3-5"/></svg></span><span class="side-nav-label">User Management</span>

</a>
<a class='side-nav-item <%= AdminNavClass("ReactivationRequest.aspx") %>' href='<%= ResolveUrl("~/Asm_WebPage/ReactivationRequest.aspx") %>' title="Reactivation Requests" aria-current='<%= AdminNavClass("ReactivationRequest.aspx") == "active" ? "page" : "false" %>'>
<span class="side-nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3H5v18h14V3h-4M9 3h6v4H9zM8 12h8M8 16h5"/></svg></span><span class="side-nav-label">Reactivation Requests</span>
<% if (PendingAppealCount.HasValue && PendingAppealCount.Value > 0) { %><span class="admin-pending-badge" aria-label="<%= PendingAppealCount.Value %> pending requests"><%= PendingAppealCount.Value > 99 ? "99+" : PendingAppealCount.Value.ToString() %></span><% } %>
</a>
<a class='side-nav-item <%= AdminNavClass("Analytics.aspx") %>' href='<%= ResolveUrl("~/Asm_WebPage/Analytics.aspx") %>' title="Analytics" aria-current='<%= AdminNavClass("Analytics.aspx") == "active" ? "page" : "false" %>'>
<span class="side-nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 3v18h17M8 17v-5M13 17V7M18 17v-8"/></svg></span><span class="side-nav-label">Analytics</span>

</a>
<% } %>
            </nav>

            <!-- Bottom: profile name and adjacent logout action -->
            <div class="side-bottom">


                <asp:Panel ID="pnlAvatar" runat="server" Visible="true" CssClass="side-profile-row">
                    <button type="button" class="side-profile-btn" onclick="toggleProfileMenu(event)" aria-label="Profile">

                        <!-- Guest: generic grey silhouette icon -->
                        <asp:Panel ID="pnlGuestAvatar" runat="server" Visible="false" CssClass="side-profile-avatar side-profile-avatar--guest">
                            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="12" cy="9" r="4" fill="currentColor"></circle>
                                <path d="M3 22c1-5 4.4-8 9-8s8 3 9 8" fill="currentColor"></path>
                            </svg>
                        </asp:Panel>

                        <!-- Logged-in: initial letter or uploaded photo -->
                        <asp:Panel ID="pnlUserAvatar" runat="server" Visible="true" CssClass="side-profile-avatar">
                            <asp:Image ID="imgAvatar" runat="server" Visible="false" CssClass="avatar-img" />
                            <asp:Label ID="lblInitial" runat="server" Text="U"></asp:Label>
                        </asp:Panel>

                        <span class="side-profile-text">
                            <asp:Label ID="lblUsernameSide" runat="server" CssClass="side-profile-label" Text="Guest"></asp:Label>
                            <asp:Label ID="lblRoleUnderName" runat="server" CssClass="side-profile-sublabel" Text="Sign in to save progress" Visible="false"></asp:Label>
                        </span>
                    </button>
                    <asp:Panel ID="pnlRoleRow" runat="server" Visible="false" CssClass="side-logout-slot">

                        <a class="side-logout-btn"
                           href="<%= ResolveUrl("~/Asm_WebPage/Logout.aspx") %>"
                           onclick="return confirm('Are you sure you want to logout?');"
                           title="Logout" aria-label="Logout">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                        </a>
                    </asp:Panel>
                </asp:Panel>
            </div>
        </aside>

        <!-- Page Container -->
        <main class="page">
            <div class="container">

                <asp:Panel ID="pnlAlert" runat="server" Visible="false" CssClass="alert">
                    <asp:Label ID="lblAlert" runat="server" Text=""></asp:Label>
                </asp:Panel>

                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </div>
        </main>

        <!-- Dropdown menu (opens near the sidebar's bottom-left Profile button) -->
        <div id="profileMenu" class="profile-menu">

            <div class="pm-avatar">
                <!-- Guest: generic grey silhouette icon (now matches the sidebar's exactly) -->
                <asp:Panel ID="pnlGuestAvatarMenu" runat="server" Visible="false" CssClass="pm-avatar-inner pm-avatar-inner--guest">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="12" cy="9" r="4" fill="currentColor"></circle>
                        <path d="M3 22c1-5 4.4-8 9-8s8 3 9 8" fill="currentColor"></path>
                    </svg>
                </asp:Panel>

                <!-- Logged-in: initial letter or uploaded photo -->
                <asp:Panel ID="pnlUserAvatarMenu" runat="server" Visible="true" CssClass="pm-avatar-inner pm-avatar-inner--user">
                    <asp:Image ID="imgAvatarMenu" runat="server" Visible="false" CssClass="pm-avatar-img" />
                    <asp:Label ID="lblInitialMenu" runat="server" Text="U"></asp:Label>
                </asp:Panel>
            </div>

            <!-- Role line only shown for logged-in users — for guests it would just
                 repeat "Guest" a second time right above the name. -->
            <asp:Panel ID="pnlRoleMenuRow" runat="server" Visible="true" CssClass="pm-role">
                <asp:Label ID="lblRoleMenu" runat="server" Text="Student"></asp:Label>
            </asp:Panel>

            <div class="pm-name">
                <asp:Label ID="lblUsernameMenu" runat="server" Text="Visitor"></asp:Label>
            </div>

            <div class="pm-actions">
                <!-- Logged-in users can edit their profile -->
                <asp:Panel ID="pnlEditProfileAction" runat="server" Visible="true">
                    <a class="pm-btn" href="<%= ResolveUrl("~/Asm_WebPage/Profile.aspx") %>">Edit Profile</a>
                </asp:Panel>

                <!-- Guests get encouraged to log in instead of Edit Profile / Logout -->
                <asp:Panel ID="pnlGuestLoginAction" runat="server" Visible="false">
                    <a class="pm-btn pm-btn--login" href="<%= ResolveUrl("~/Asm_WebPage/Login.aspx") %>">Log In</a>
                </asp:Panel>
            </div>

        </div>

        <script>
            function toggleProfileMenu(e) {
                e.stopPropagation();
                var menu = document.getElementById("profileMenu");
                if (menu) menu.classList.toggle("show");
            }

            document.addEventListener("click", function () {
                var menu = document.getElementById("profileMenu");
                if (menu) menu.classList.remove("show");
            });

            // ===== Sidebar collapse / expand (icon-only rail), remembered across pages =====
            function toggleSidebar() {
                var sidebar = document.getElementById("dashSidebar");
                var collapsed = sidebar.classList.toggle("collapsed");
                document.body.classList.toggle("sidebar-collapsed", collapsed);
                localStorage.setItem("keycode_sidebar_collapsed", collapsed ? "1" : "0");
            }

            (function () {
                if (localStorage.getItem("keycode_sidebar_collapsed") === "1") {
                    document.getElementById("dashSidebar").classList.add("collapsed");
                    document.body.classList.add("sidebar-collapsed");
                }
            })();
        </script>

    </form>
</body>
</html>
