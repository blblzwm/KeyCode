<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="KEYCODE.Site" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>KEYCODE</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="<%= ResolveUrl("~/Asm_StyleSheet/WebPageStyle.css") %>" rel="stylesheet" />
    <link href="<%= ResolveUrl("~/Asm_StyleSheet/MasterStyle.css") %>" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>

<body>
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" />

        <!-- Topbar -->
        <header class="topbar">

            <!-- LEFT: logo only -->
            <div class="topbar__left">
                <a class="brand" href="<%= ResolveUrl("~/Asm_WebPage/HomePage.aspx") %>">
                    <img src="<%= ResolveUrl("~/logo.png") %>" alt="KEYCODE Logo" class="brand__logo" />
                </a>
            </div>

            <!-- RIGHT: forum + avatar + role -->
            <div class="topbar__right">

                <!-- Forum icon (hide for guest) -->
                <asp:Panel ID="pnlForumIcon" runat="server" Visible="true" CssClass="topbar__forum">
                    <a class="icon-btn forum-btn"
                       href="<%= ResolveUrl("~/Asm_WebPage/Forum.aspx") %>"
                       title="Forum">💬</a>
                </asp:Panel>

                <!-- Avatar + dropdown (hide for non-reg student) -->
                <asp:Panel ID="pnlAvatar" runat="server" Visible="true" CssClass="topbar__avatar">

                    <button type="button"
                            class="avatar-btn"
                            onclick="toggleProfileMenu(event)"
                            aria-label="Profile">
                        <asp:Image ID="imgAvatar" runat="server" Visible="false" CssClass="avatar-img" />
                        <asp:Label ID="lblInitial" runat="server" Text="U"></asp:Label>
                    </button>

                </asp:Panel>


                <!-- Role pill always show -->
                <span class="pill pill--role">
                    <asp:Label ID="lblRole" runat="server" Text="Guest"></asp:Label>
                </span>

            </div>

        </header>

        <!-- Page Container -->
        <main class="page">
            <div class="container">

                <asp:Panel ID="pnlAlert" runat="server" Visible="false" CssClass="alert">
                    <asp:Label ID="lblAlert" runat="server" Text=""></asp:Label>
                </asp:Panel>

                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </div>
        </main>

        <!-- Dropdown menu -->
        <div id="profileMenu" class="profile-menu">

            <div class="pm-avatar">
                <asp:Image ID="imgAvatarMenu" runat="server" Visible="false" CssClass="pm-avatar-img" />
                <asp:Label ID="lblInitialMenu" runat="server" Text="U"></asp:Label>
            </div>

            <div class="pm-role">
                <asp:Label ID="lblRoleMenu" runat="server" Text="Student"></asp:Label>
            </div>

            <div class="pm-name">
                <asp:Label ID="lblUsernameMenu" runat="server" Text="Visitor"></asp:Label>
            </div>

            <div class="pm-actions">
                <a class="pm-btn" href="<%= ResolveUrl("~/Asm_WebPage/Profile.aspx") %>">Edit Profile</a>
            <a class="pm-btn ghost"
               href="<%= ResolveUrl("~/Asm_WebPage/Logout.aspx") %>"
               onclick="return confirm('Are you sure you want to logout?');">Logout</a>
            </div>

        </div>

        <script>
            function toggleProfileMenu(e) {
                e.stopPropagation();
                var menu = document.getElementById("profileMenu");
                if (menu) menu.classList.toggle("show");
            }

            document.addEventListener("click", function () {
                var menu = document.getElementById("profileMenu");
                if (menu) menu.classList.remove("show");
            });
        </script>

    </form>
</body>
</html>
